[Unit]
Description=Insurance claims demo — laya service (console + engines)
PartOf=decision-demo.target

[Service]
Type=simple
EnvironmentFile=%h/.config/systemd/user/decision-demo.env
ExecStart=/bin/sh -c 'if [ -n "$DEMO_BOX" ]; then exec "$DISTROBOX_BIN" enter "$DEMO_BOX" -- "$LAYA_PY" "$DEMO_DIR/laya_service.py" "$LAYA_PORT"; else exec "$LAYA_PY" "$DEMO_DIR/laya_service.py" "$LAYA_PORT"; fi'
# The python process lives inside the distrobox container and survives the wrapper
# being killed, so stop it explicitly (host pkill sees the container processes).
ExecStop=/bin/sh -c 'pkill -f "laya_service.py $LAYA_PORT" 2>/dev/null || :'
Restart=on-failure
RestartSec=5
