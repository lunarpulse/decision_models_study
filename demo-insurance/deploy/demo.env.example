# decision-demo systemd --user units: machine parameters.
# Copy to deploy/demo.env (machine-specific, not committed) and edit, then run
# deploy/install_units.sh, which copies it to ~/.config/systemd/user/decision-demo.env
# where every unit picks it up via EnvironmentFile.
# The values below are the live demo machine (services inside distrobox "ai-dev").

# Demo tree the units run from — where sync_live.sh copies the repo.
DEMO_DIR=/home/lunarpulse/AI/catalog/decision-study/demo-insurance

# Run the python services inside this distrobox (empty = run directly on the host).
# The tunnel (cloudflared) always runs on the host.
DEMO_BOX=ai-dev

# distrobox launcher (host path).
DISTROBOX_BIN=/usr/bin/distrobox

# Python interpreters — paths as seen INSIDE the box.
LAYA_PY=/opt/ai-tools/venv-laya/bin/python
DECIDER_PY=/opt/ai-tools/venv-decider/bin/python
# The studio imports laya/torch too; leave empty to reuse LAYA_PY.
STUDIO_PY=/opt/ai-tools/venv-laya/bin/python

# Ports.
LAYA_PORT=8901
DECIDER_PORT=8902
STUDIO_PORT=8903

# cloudflared binary (host path) for decision-demo-tunnel.service.
CLOUDFLARED_BIN=/home/lunarpulse/bin/cloudflared
